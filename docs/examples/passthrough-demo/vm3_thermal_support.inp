/BATCH
! ============================================================
! passthrough 端到端「已知答案」夹具 #2:官方 Verification Manual VM3
! Thermally Loaded Support Structure(铜/钢三杆并联,机械载荷 + 均匀温升,
! 求两种材料的热应力 —— 热-结构耦合,比 VM1 更贴近 HIP 物理场景)
!
! 官方来源:
!   * Ansys Mechanical APDL Verification Manual — VM3:
!     参考解 Timoshenko, Strength of Materials, Part I, 3rd ed., 1955, p.30, prob.9
!   * 命令流形态(LINK180 + SECTYPE)取自官方 ansys/pymapdl-examples 仓库
!     examples/verif-manual/vm-003-thermally_loaded_support_structure.py
!
! 官方目标值(E2E 断言口径,见 README):
!   钢杆(MAT 2,中间杆)轴向应力 = 19695 psi
!   铜杆(MAT 1,两侧杆)轴向应力 = 10152 psi
!   (目标为手册圆整值,断言容差放宽到 1e-2)
!
! 单位:官方原制 in / lbf / psi / °F(验证服务不预设单位制)。
!
! 模型:顶部三节点(-10/0/+10)全固定,底部三节点(-10/0/+10,y=-20)
! 经 CP 耦合 UY 成刚性横梁;节点 5 受 -4000 lb;TREF 70°F,
! BFUNIF TEMP 80°F(均匀温升 ΔT=10°F,铜 α=92e-7 > 钢 α=70e-7,
! 温升使铜杆受压、钢杆受拉)。
!
! 本文件写出的契约产物(均落作业目录根):
!   progress.csv = 阶段侧车:MODEL / SOLVE / POST(整文件重写式,§4.4)
!   disp.csv     = 全节点 y 坐标 + UY 位移表(declared_outputs 声明它)
!   results.csv  = 短标签标量(服务自动解析进 result.values,§4.5,勿声明)
!
! 提交侧参数:declared_outputs = ["disp.csv"];workflow 建议 "VM3_E2E"。
! 坑自查(*VWRITE 字符字面量 ≤8 字符):
!   'MODEL' 'SOLVE' 'POST' 'node' 'y_in' 'uy_in'
!   'st_strs' 'cu_strs' 'ratio_st' 'ratio_cu'(全部 ≤8)。
! ============================================================

/TITLE,VM3 THERMALLY LOADED SUPPORT STRUCTURE
/PREP7
ANTYPE,STATIC
ET,1,LINK180                  ! 3D 杆单元
SECTYPE,1,LINK
SECDATA,0.1                   ! 截面积 0.1 in^2
MP,EX,1,16E6                  ! MAT 1 = 铜
MP,ALPX,1,92E-7
MP,EX,2,30E6                  ! MAT 2 = 钢
MP,ALPX,2,70E-7
TREF,70                       ! 参考温度(热应变零点)

! ---- 节点:顶排 y=0(x=-10/0/+10),底排 y=-20,FILL 补中点 ----
N,1,-10
N,3,10
FILL                          ! → 节点 2(0,0)
N,4,-10,-20
N,6,10,-20
FILL                          ! → 节点 5(0,-20)

! ---- 单元:两侧铜杆(MAT 1)+ 中间钢杆(MAT 2)----
E,1,4                         ! 单元 1:左铜杆
E,3,6                         ! 单元 2:右铜杆
MAT,2
E,2,5                         ! 单元 3:中钢杆

! ---- 边界/载荷(官方原题)----
CP,1,UY,5,4,6                 ! 底排 UY 耦合 = 刚性横梁
D,1,ALL,,,3                   ! 顶排(节点 1..3)全固定
F,5,FY,-4000                  ! 横梁中点向下 4000 lb
BFUNIF,TEMP,80                ! 均匀温升至 80°F(ΔT=+10°F)
FINISH

! ---- 阶段侧车首行:MODEL 完成 ----
NSTG = 3
*DIM,PGLAB,CHAR,NSTG
*DIM,PGTIM,ARRAY,NSTG
PGLAB(1) = 'MODEL'
PGTIM(1) = 0
*CFOPEN,progress,csv
JL   = PGLAB(1)
JTV  = PGTIM(1)
*VWRITE,JL,JTV
(A8,',',E16.8)
*CFCLOSE

/SOLU
NSUBST,1
OUTRES,ALL,ALL
SOLVE
FINISH

! ---- 阶段侧车重写:登记 SOLVE ----
PGLAB(2) = 'SOLVE'
PGTIM(2) = 1
*CFOPEN,progress,csv
*DO,J,1,2
  JL   = PGLAB(J)
  JTV  = PGTIM(J)
  *VWRITE,JL,JTV
(A8,',',E16.8)
*ENDDO
*CFCLOSE

/POST1
SET,LAST

! ---- 官方后处理套路:ETABLE LS,1 取 LINK180 轴向应力 ----
ETABLE,STRS_ST,LS,1
ETABLE,STRS_CO,LS,1
*GET,STS_ST,ELEM,3,ETAB,STRS_ST   ! 钢杆(单元 3)应力,目标 19695 psi
*GET,STS_CO,ELEM,2,ETAB,STRS_CO   ! 铜杆(单元 2)应力,目标 10152 psi
RATIO_ST = STS_ST/19695           ! 断言比值 ≈ 1
RATIO_CO = STS_CO/10152

! ---- disp.csv:全节点 y 坐标 + UY(declared_outputs 声明)----
*GET,NNOD,NODE,,COUNT
*DIM,NODNO,ARRAY,NNOD
*DIM,YLOC,ARRAY,NNOD
*DIM,UYA,ARRAY,NNOD
*VGET,NODNO(1),NODE,1,NLIST
*VGET,YLOC(1),NODE,1,LOC,Y
*VGET,UYA(1),NODE,1,U,Y
*CFOPEN,disp,csv
*VWRITE,'node','y_in','uy_in'
(A4,',',A4,',',A5)
*VWRITE,NODNO(1),YLOC(1),UYA(1)
(E16.8,',',E16.8,',',E16.8)
*CFCLOSE

! ---- results.csv:短标签 + 数值(服务自动解析,勿声明)----
*CFOPEN,results,csv
*VWRITE,'st_strs',STS_ST
(A8,',',E16.8)
*VWRITE,'cu_strs',STS_CO
(A8,',',E16.8)
*VWRITE,'ratio_st',RATIO_ST
(A8,',',E16.8)
*VWRITE,'ratio_cu',RATIO_CO
(A8,',',E16.8)
*CFCLOSE

! ---- 阶段侧车末帧重写:登记 POST ----
PGLAB(3) = 'POST'
PGTIM(3) = 1
*CFOPEN,progress,csv
*DO,J,1,3
  JL   = PGLAB(J)
  JTV  = PGTIM(J)
  *VWRITE,JL,JTV
(A8,',',E16.8)
*ENDDO
*CFCLOSE

FINISH
