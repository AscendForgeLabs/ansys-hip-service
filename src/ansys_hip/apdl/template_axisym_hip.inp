/BATCH
! ============================================================
! 2D 轴对称 HIP 全过程(阶段 1 冒烟:线弹性)— PLANE183
! 外压沿工艺曲线分段坡道(外圆柱面+上下端面);可选 NLGEOM
! 位移/等效应量极值 → series.csv(T-位移历程)+ summary.csv
! 生成: ansys-hip-service kernels/fem.py(template_axisym_hip.inp)
! ============================================================
/PREP7
ET,1,PLANE183
KEYOPT,1,3,1                 ! 轴对称
! ---- 径向分区矩形 + 共形粘接 ----
{% for zone in zones %}
RECTNG,{{ zone.r_from|g }},{{ zone.r_to|g }},{{ z_from|g }},{{ z_to|g }}
{% endfor %}
AGLUE,ALL
! ---- 材料(保温温度单值线弹性;1=powder 2=capsule) ----
{% for line in material_lines %}
{{ line }}
{% endfor %}
! ---- 分区赋材料 ----
ALLSEL,ALL
{% for zone in zones %}
ASEL,S,LOC,X,{{ zone.sel_lo|g }},{{ zone.sel_hi|g }}
AATT,{{ zone.mat }},1,0
{% endfor %}
ALLSEL,ALL
ESIZE,{{ mesh_size_mm|g }}
AMESH,ALL
! ---- 约束: 轴上 UX=0,底面 UY=0 ----
NSEL,S,LOC,X,0
D,ALL,UX,0
NSEL,S,LOC,Y,{{ z_from|g }}
D,ALL,UY,0
ALLSEL,ALL
{% if nlgeom %}NLGEOM,1{% else %}NLGEOM,0{% endif %}
/SOLU
ANTYPE,STATIC
KBC,0
OUTRES,ALL,ALL
dmaxall = 0
vmaxall = 0
{% for segment in segments %}
! ---- 段 {{ loop.index }}: t = {{ segment.t_end|g }} s,外压 {{ segment.pressure|g }} MPa ----
LSEL,S,LOC,X,{{ outer_r|g }}
LSEL,A,LOC,Y,{{ z_to|g }}
LSEL,A,LOC,Y,{{ z_from|g }}
SFL,ALL,PRES,{{ segment.pressure|g }}
ALLSEL,ALL
TIME,{{ segment.t_end|g }}
NSUBST,{{ segment.nsub }}
SOLVE
/POST1
SET,LAST
NSORT,U,X,0,1
*GET,uxm,SORT,,MAX
NSORT,U,Y,0,1
*GET,uym,SORT,,MAX
dcur = MAX(uxm,uym)
dmaxall = MAX(dmaxall,dcur)
ETABLE,vmse,S,EQV
ESORT,ETAB,vmse
*GET,vcur,SORT,,MAX
vmaxall = MAX(vmaxall,vcur)
tcur = {{ segment.t_end|g }}
{% if loop.first %}*CFOPEN,series,csv{% else %}*CFOPEN,series,csv,,,APPEND{% endif %}
*VWRITE,tcur,0,dcur
(E16.8,',',I2,',',E16.8)
*CFCLOSE
/SOLU
{% endfor %}
/POST1
SET,LAST
tfinal = {{ segments[-1].t_end|g }}
*CFOPEN,summary,csv
*VWRITE,'displacement_max_mm',dmaxall
(A32,',',E16.8)
*VWRITE,'von_mises_max_mpa',vmaxall
(A32,',',E16.8)
*VWRITE,'time_final_s',tfinal
(A32,',',E16.8)
*CFCLOSE
FINISH
