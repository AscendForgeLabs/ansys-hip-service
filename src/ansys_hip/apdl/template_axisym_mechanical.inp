/BATCH
! ============================================================
! 2D 轴对称保温段力学(阶段 1 冒烟:线弹性)— PLANE183
! 保温压力单工况;中截面径向应力剖面 → series.csv(第 1 列 = 半径)
! 生成: ansys-hip-service kernels/fem.py(template_axisym_mechanical.inp)
! ============================================================
/PREP7
ET,1,PLANE183
KEYOPT,1,3,1                 ! 轴对称
! ---- 径向分区矩形 + 共形粘接 ----
{% for zone in zones %}
RECTNG,{{ zone.r_from|g }},{{ zone.r_to|g }},{{ z_from|g }},{{ z_to|g }}
{% endfor %}
AGLUE,ALL
! ---- 材料(保温温度单值线弹性;1=powder 2=capsule) ----
{% for line in material_lines %}
{{ line }}
{% endfor %}
! ---- 分区赋材料 ----
ALLSEL,ALL
{% for zone in zones %}
ASEL,S,LOC,X,{{ zone.sel_lo|g }},{{ zone.sel_hi|g }}
AATT,{{ zone.mat }},1,0
{% endfor %}
ALLSEL,ALL
ESIZE,{{ mesh_size_mm|g }}
AMESH,ALL
! ---- 约束: 轴上 UX=0,底面 UY=0 ----
NSEL,S,LOC,X,0
D,ALL,UX,0
NSEL,S,LOC,Y,{{ z_from|g }}
D,ALL,UY,0
ALLSEL,ALL
/SOLU
ANTYPE,STATIC
! ---- 保温压力(外圆柱面+上下端面,等静压) ----
LSEL,S,LOC,X,{{ outer_r|g }}
LSEL,A,LOC,Y,{{ z_to|g }}
LSEL,A,LOC,Y,{{ z_from|g }}
SFL,ALL,PRES,{{ hold_pressure_mpa|g }}
ALLSEL,ALL
TIME,1
NSUBST,1
OUTRES,ALL,ALL
SOLVE
/POST1
SET,LAST
NSORT,U,X,0,1
*GET,uxm,SORT,,MAX
NSORT,U,Y,0,1
*GET,uym,SORT,,MAX
dmax = MAX(uxm,uym)
ETABLE,vmse,S,EQV
ESORT,ETAB,vmse
*GET,vmax,SORT,,MAX
*CFOPEN,summary,csv
*VWRITE,'displacement_max_mm',dmax
(A32,',',E16.8)
*VWRITE,'von_mises_max_mpa',vmax
(A32,',',E16.8)
*CFCLOSE
! ---- 中截面径向应力剖面(*GET SX;半径在第 1 列) ----
{% for sample in section_samples %}
nsec{{ loop.index }} = NODE({{ sample.radius|g }},{{ z_mid|g }})
rcur{{ loop.index }} = {{ sample.radius|g }}
{% endfor %}
{% for sample in section_samples %}
*GET,ssec{{ loop.index }},NODE,nsec{{ loop.index }},S,X
{% endfor %}
*CFOPEN,series,csv
{% for sample in section_samples %}
*VWRITE,rcur{{ loop.index }},1,ssec{{ loop.index }}
(E16.8,',',I2,',',E16.8)
{% endfor %}
*CFCLOSE
FINISH
